# ---------------------------------------------------------------------------
# Secrets — never commit these. They are live credentials.
# If you ever need to change one, edit the file on the server, not here.
# ---------------------------------------------------------------------------
**/config/paymongo_keys.php
**/config/db.php
**/config/jwt.php
**/config/mail.php
**/config/fcm.php
.env
*.env

# ---------------------------------------------------------------------------
# Derived or regenerable — no value in versioning, huge churn.
# ---------------------------------------------------------------------------
**/.flutterflow/
**/.dart_tool/
**/build/
**/node_modules/
**/.ffai_staging/
*.log

# ---------------------------------------------------------------------------
# Duplicates and archives. Git itself is the backup now.
# ---------------------------------------------------------------------------
backups/
solecraftfinal - Copybackup/
*.rar
*.zip

# ---------------------------------------------------------------------------
# OS noise
# ---------------------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store

# ---------------------------------------------------------------------------
# Server content that is data, not code.
#
# Customer- and admin-uploaded product images, and the hero footage — 45 MB of
# video alone. Git is not an image backup: these come back from the host's own
# backups, and versioning them would make every clone carry every photo the
# shop has ever had. The code that serves them is tracked; the bytes are not.
# ---------------------------------------------------------------------------
server-patch/uploads/
server-patch/sql/uploads/
server-patch/assets/media/hero-video/
